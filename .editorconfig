root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# GDScript and Godot files use tabs (Godot's default style)
[*.{gd,tscn,tres,godot,cfg}]
indent_style = tab
indent_size = 4

# The originals are kept exactly as they were made
[legacy/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
