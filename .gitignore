# Website builds (astro build -> dist/, tools/i18n.ts build -> _site/, the Godot web export -> _site/play/) and tooling
dist/
_site/
.astro/
node_modules/
work*.json

# ---------------------------------------------------------------------------
# Godot
# ---------------------------------------------------------------------------
# Editor cache. Also holds export_credentials.cfg (keystore passwords), so it
# must never be committed.
.godot/
**/.godot/
# Android build template, installed per machine for Gradle builds
game/android/
# Mono/C# leftovers (the project is GDScript-only)
.mono/
mono_crash.*.json
*.translation
# Build output
build/
*.apk
*.aab
*.idsig
*.pck
*.zip
*.tpz

