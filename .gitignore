# Secrets and signing keys: never commit these. See docs/BUILDING.md.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pfx
*.cer
*.pem
*.p12
*.key
*.keystore
*.jks
keystore.properties
signing.properties
release-keystore*
export_credentials.cfg
*service-account*.json
*-credentials.json
play-store-*.json
google-services.json
client_secret*.json
secrets/
credentials/

